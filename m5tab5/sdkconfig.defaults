# jinxed-writer-for-m5tab5
#
# These only seed a NEW sdkconfig. After changing anything here:
#
#     rm sdkconfig && idf.py build

CONFIG_IDF_TARGET="esp32p4"

# The Tab5s so far are chip rev v1.3. Spec section 1.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The gfx shadow buffer is 1.8 MB of PSRAM. 200 MHz PSRAM is behind the
# experimental-features gate, as in defeatist-music-player.
CONFIG_SPIRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# USB host, as feckless_drivers' README asks. The keyboard may arrive
# through a hub (plenty of keyboards are one).
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The SD card: long names for ".2026-11-02.md.h0", which exFAT needs
# anyway; UTF-8 names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# ---------------------------------------------------------------------------
# Wi-Fi through the C6, for sends (main/sender.c). From Defeatist's
# sdkconfig.defaults, where each is explained at length; in short:
#
# wifi.c calls esp_hosted_init() itself, after powering the C6.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# The Tab5's preset. A board's wiring is not a menu choice.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
# The C6's EN is GPIO15. The one pin wifi.c cannot set from code.
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15

# TLS and lwIP buffers in PSRAM: internal RAM is the radio's DMA pool.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The ECDSA engine is not usable on chip rev v1.3: each signature is a
# failed try at it, an error line, then software anyway. Straight to
# software.
CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=n
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
# The server's certificate is checked against IDF's CA bundle (mailsend).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Room for the three NIST servers wifi.c names. The default is 1, and IDF
# 6.1 makes the extra initialisers an error rather than a warning. NTP is
# off here (sender.c's hooks), but wifi.c is compiled whatever.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# The send task's stack is in PSRAM. That needs
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM, which is on by default with
# SPIRAM; it is not set here because the bootloader's configure pass,
# which has no SPIRAM, notes it as "not visible". sender.c's #error is
# the check.
